# 2026ican 后端环境变量样例（复制为 .env 后填写；.env 已被 .gitignore 覆盖，严禁入库）
# 任何 Key 不上传 GitHub、不写进截图/JSON/README（docs/VLM队员执行手册.md §2.2/§7.3）

# ---- GLM 文本模型（agentkit 六角色研判/指挥员问答）：团队 Coding Plan Key 或平台 Key ----
# 与 VLM 标准 API Key 严格分变量存放，不可混用
FIREOPS_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
FIREOPS_LLM_MODEL=glm-4-flash
FIREOPS_LLM_API_KEY=
FIREOPS_LLM_TIMEOUT=12

# ---- VLM 视觉分析（glm-4.6v-flash，E-2 交付已到：docs/vlm-delivery/ 2026-09-06）----
# 即队员交付包 .env 中的 ZHIPU_API_KEY（标准 API Key，私下渠道交付），填到本变量
# 未填 Key 时全系统确定性离线运行（vlm_explanation 走规则回退解释器）
FIRE_VLM_API_KEY=
FIRE_VLM_MODEL=glm-4.6v-flash
FIRE_VLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# 交付实测（48 次调用）：纯模型最慢 51s，90s 为安全上限
FIRE_VLM_TIMEOUT=90
# 备选：外部 VLM 适配器端点（优先于直连；api-contract §10.1 级①）
FIRE_VLM_ENDPOINT=

# ---- PWM-YOLO 检测服务（E-1 交付后填写；api-contract §9）----
FIRE_YOLO_ENDPOINT=
