# 高德开放平台「Web端(JS API)」类型 Key（https://console.amap.com 免费申请，5 分钟）
# 用途：态势总览的高德卫星底图。缺失时页面自动回退等高线示意图（功能不受影响，非故障）。
# 配置方法：把本文件复制为同目录下的 .env（frontend/.env）并填入两项后重启 npm run dev。
# 与该 Key 配对的安全密钥 securityJsCode（开发环境明文配置；生产建议走代理注入 jscode）
VITE_AMAP_KEY=
VITE_AMAP_SECURITY_CODE=

# GLM 多 Agent 大语言模型（留空 = 确定性离线运行，演示不受影响）
FIREOPS_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
FIREOPS_LLM_API_KEY=
FIREOPS_LLM_MODEL=glm-4-flash
